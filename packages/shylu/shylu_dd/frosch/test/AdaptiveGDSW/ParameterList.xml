<?xml version="1.0" encoding="utf-8"?>
<ParameterList name="Adaptive GDSW Example">
    <!-- Pass -DHAVE_FROSch_DEBUG as compiler flag in cmake configure script to include debug functions -->
    <ParameterList name="Debug Output: main">
        <Parameter name="Row Map for FE Graph"                                      type="bool"     value="false"/>
        <Parameter name="Owned-Plus-Shared Map for FE Graph"                        type="bool"     value="false"/>
        <Parameter name="Row Map of Stiffness Matrix before endAssembly"            type="bool"     value="false"/>
        <Parameter name="Col Map of Stiffness Matrix before endAssembly"            type="bool"     value="false"/>
        <Parameter name="Repeated Map"                                              type="bool"     value="false"/>
        <Parameter name="Row Map Stiffness Matrix"                                  type="bool"     value="false"/>
        <Parameter name="Stiffness Matrix"                                          type="bool"     value="false"/>
        <Parameter name="Local Neumann Matrices"                                    type="bool"     value="false"/>
    </ParameterList>

    <ParameterList name="main">
        <Parameter name="Number of finite elements in x and y direction"            type="int"      value="8"/>
        <Parameter name="Coefficient"                                               type="double"   value="1.0e6"/>
        <Parameter name="Coefficient step"                                          type="int"      value="2"/>
        <Parameter name="Export subdomain meshes to mesh_i.txt"                     type="bool"     value="false"/>
        <Parameter name="Export stiffness matrix to fem_matrix.txt"                 type="bool"     value="false"/>
        <Parameter name="Export load vector to fem_rhs.txt"                         type="bool"     value="false"/>
        <Parameter name="Export solution to fem_sol.txt"                            type="bool"     value="false"/>
    </ParameterList>

    <ParameterList name="Linear Solver">                                            <!-- Linear Solver -->
        <Parameter name="Linear Solver Type"                                        type="string"   value="Belos"/> <!-- {"Belos","Amesos2"} -->
        <ParameterList name="Linear Solver Types">                                  <!-- Linear Solver/Linear Solver Types -->
            <ParameterList name="Belos">                                            <!-- Linear Solver/Linear Solver Types/Belos -->
                <Parameter name="Left Preconditioner If Unspecified"                type="bool"     value="true"/>
                <Parameter name="Solver Type"                                       type="string"   value="Block CG"/> <!-- {"Block GMRES","Block CG"} -->
                <ParameterList name="Solver Types">
                    <ParameterList name="Block CG">
                        <Parameter name="Convergence Tolerance"                     type="double"   value="1e-6"/>
                        <Parameter name="Maximum Iterations"                        type="int"      value="500"/>
                        <Parameter name="Output Frequency"                          type="int"      value="1"/>
                        <Parameter name="Verbosity"                                 type="int"      value="100"/>
                    </ParameterList>
                    <ParameterList name="Block GMRES">
                        <!--<Parameter name="PreconditionerPosition" type="string" value="left"/>-->
                        <Parameter name="Block Size"                                type="int"      value="1"/>
                        <Parameter name="Num Blocks"                                type="int"      value="100"/>
                        <Parameter name="Convergence Tolerance"                     type="double"   value="1e-6"/>
                        <Parameter name="Maximum Iterations"                        type="int"      value="100"/>
                        <Parameter name="Maximum Restarts"                          type="int"      value="0"/>
                        <Parameter name="Output Frequency"                          type="int"      value="1"/>
                        <Parameter name="Show Maximum Residual Norm Only"           type="bool"     value="false"/>
                        <Parameter name="Verbosity"                                 type="int"      value="50"/>
                        <Parameter name="Implicit Residual Scaling"                 type="string"   value="None"/>  <!-- "Norm of Initial Residual","Norm of RHS","Norm of Preconditioned Initial Residual","None" -->
                        <Parameter name="Explicit Residual Scaling"                 type="string"   value="None"/>
                        <Parameter name="Explicit Residual Test"                    type="bool"     value="true"/>
                        <Parameter name="User Status Tests Combo Type"              type="string"   value="AND"/>
                    </ParameterList>
                </ParameterList>
                <ParameterList name="VerboseObject">
                    <Parameter name="Verbosity Level"                               type="string"   value="high"/>  <!-- "none", "medium", "high", "extreme"-->
                </ParameterList>
            </ParameterList> <!-- Belos -->

            <ParameterList name="Amesos2">                                          <!-- Linear Solver/Linear Solver Types/Amesos2 -->
                <Parameter name="Solver Type"                                       type="string"   value="KLU2"/>
            </ParameterList>
        </ParameterList> <!-- Linear Solver Types -->

        <Parameter name="Preconditioner Type"                                       type="string"   value="FROSch"/>
        <ParameterList name="Preconditioner Types">                                 <!-- Linear Solver/Preconditioner Types -->
            <ParameterList name="FROSch">                                           <!-- Linear Solver/Preconditioner Types/FROSch -->
                <Parameter name="FROSch Preconditioner Type"                        type="string"   value="GDSWPreconditioner"/> <!-- "OneLevelPreconditioner", "GDSWPreconditioner", ... -->
                <Parameter name="Overlap"                                           type="int"      value="0"/>

                <ParameterList name="AlgebraicOverlappingOperator">                 <!-- Linear Solver/Preconditioner Types/FROSch/AlgebraicOverlappingOperator -->
                    <Parameter name="Combine Values in Overlap"                     type="string"   value="Full"/>  <!-- "Restricted", "Averaging", "Full" -->
                    <ParameterList name="Solver">
                        <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                        <Parameter name="Solver"                                    type="string"   value="Klu"/>
                    </ParameterList>
                </ParameterList>

                <ParameterList name="GDSWCoarseOperator">                           <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator -->
                    <ParameterList name="Blocks">                                   <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator/Blocks -->
                        <ParameterList name="1">
                            <Parameter name="Use For Coarse Space"                  type="bool"     value="true"/>
                            <Parameter name="Rotations"                             type="bool"     value="true"/>
                            <ParameterList name="Custom">
                                <Parameter name="Vertices: translations"            type="bool"     value="true"/>
                                <Parameter name="ShortEdges: translations"          type="bool"     value="true"/>
                                <Parameter name="ShortEdges: rotations"             type="bool"     value="true"/>
                                <Parameter name="StraightEdges: translations"       type="bool"     value="true"/>
                                <Parameter name="StraightEdges: rotations"          type="bool"     value="true"/>
                                <Parameter name="Edges: translations"               type="bool"     value="true"/>
                                <Parameter name="Edges: rotations"                  type="bool"     value="true"/>
                                <Parameter name="Faces: translations"               type="bool"     value="true"/>
                                <Parameter name="Faces: rotations"                  type="bool"     value="true"/>
                            </ParameterList>
                        </ParameterList>
                    </ParameterList>

                    <ParameterList name="ExtensionSolver">                          <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator/ExtensionSolver -->
                        <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                        <Parameter name="Solver"                                    type="string"   value="Klu"/>
                    </ParameterList>

                    <ParameterList name="Distribution">                             <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator/Distribution -->
                        <Parameter name="Type"                                      type="string"   value="linear"/>
                        <Parameter name="NumProcs"                                  type="int"      value="1"/>
                        <Parameter name="Factor"                                    type="double"   value="1.0"/>
                        <Parameter name="GatheringSteps"                            type="int"      value="1"/>
                        <ParameterList name="Gathering Communication">
                            <Parameter name="Send type"                             type="string"   value="Send"/>
                        </ParameterList>
                    </ParameterList>

                    <ParameterList name="CoarseSolver">                             <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator/CoarseSolver -->
                        <Parameter name="SolverType"                                type="string"   value="Amesos2"/>
                        <Parameter name="Solver"                                    type="string"   value="Klu"/>
                    </ParameterList>

                    <Parameter name="Use Adaptive Coarse Space"                     type="bool"     value="true"/>
                    <ParameterList name="Adaptive problems">                        <!-- Linear Solver/Preconditioner Types/FROSch/GDSWCoarseOperator/Adaptive problems -->
                        <Parameter name="Tolerance for the selection of functions"  type="double"   value="0.03"/>
                        <Parameter name="Solver Type"                               type="string"   value="LAPACK"/>
                        <ParameterList name="Solver Types">
                            <ParameterList name="LAPACK">
                                <Parameter name="Check symmetry"                    type="bool"     value="no"/>
                            </ParameterList>
                        </ParameterList>
                    </ParameterList>

                </ParameterList> <!-- GDSWCoarseOperator -->
            </ParameterList> <!-- FROSch -->
        </ParameterList> <!-- Preconditioner Types -->
    </ParameterList> <!-- Linear Solver -->
</ParameterList>
